{
	"schemaVersion": 1,
	"id": "mtsr",
	"version": "${version}",
	"name": "Mod Texture Super Resolution",
	"description": "Mod Texture Super Resolution is a client-side Fabric mod for Minecraft. Detects textures loaded by mods and runs ESRGAN to upscale, cache and load upscaled textures. Does not affect gameplay or logic.",
	"authors": [
		"danvb10"
	],
	"contact": {
		"homepage": "https://modrinth.com/user/danvanbueren",
		"sources": "https://github.com/danvanbueren/mod-texture-super-resolution",
		"issues": "https://github.com/danvanbueren/mod-texture-super-resolution/issues"
	},
	"license": "GPL-3.0",
	"icon": "assets/mtsr/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"me.danvb10.mtsr.ClientEntrypoint"
		],
		"modmenu": [
			"me.danvb10.mtsr.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"mtsr.mixins.json"
	],
	"custom" : {
		"modmenu" : {
			"links" : {
				"modmenu.github_releases" : "https://github.com/danvanbueren/mod-texture-super-resolution/releases",
				"modmenu.modrinth" : "https://modrinth.com/user/danvanbueren"
			}
		}
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.1 <26.2",
		"java": ">=25",
		"fabric-api": "*",
		"modmenu": ">=18.0.0",
		"owo": ">=0.13.0"
	},
	"suggests": {

	}
}